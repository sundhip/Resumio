{
  "name": "resumio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "kill:ports": "node -e \"const {execSync}=require('child_process');[3001,5173].forEach(p=>{try{const pid=execSync('netstat -ano | findstr :'+p+' | findstr LISTENING',{encoding:'utf8'}).trim().split(/\\s+/).pop();if(pid&&/^\\d+$/.test(pid))execSync('taskkill /PID '+pid+' /F /T')}catch(e){}})\"",
    "dev": "npm run kill:ports && concurrently \"tsx server/index.ts\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx server/index.ts",
    "seed": "tsx server/scripts/seed-db.ts",
    "migrate:mongo": "tsx server/scripts/migrate-sqlite-to-mongo.ts",
    "test:mongo": "tsx server/test-mongodb.ts",
    "test:persistence": "tsx server/scripts/verify-atlas-persistence.ts",
    "test": "tsx server/test-all.ts",
    "test:all": "tsx server/test-all.ts",
    "test:smoke": "tsx server/test-phase11-smoke.ts",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "ml:pipeline": "python ml/scripts/run_pipeline.py",
    "ml:test": "python -m pytest ml/tests -v"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.44.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.1",
    "multer": "^2.3.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  }
}
