      "id": 1,
      "title": "API Service Health & Latency SLOs",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "HTTP Request Throughput",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(resumio_http_requests_total[1m])) by (status)",
          "legendFormat": "Status {{status}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "API p95 / p99 Latency (SLO: p95 < 250ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "resumio_http_request_duration_seconds{quantile=\"0.95\"}",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "resumio_http_request_duration_seconds{quantile=\"0.99\"}",
          "legendFormat": "p99 Latency"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Resume Parse Success Rate (SLO: >= 98.5%)",
      "type": "gauge",
      "targets": [
        {
          "expr": "resumio_parse_success_rate",
          "legendFormat": "Success Rate"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "AI & Model Operations Monitoring",
