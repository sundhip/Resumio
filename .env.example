# ===================================================
# Resumio - Environment Variables Configuration
# ===================================================

# Server Configuration
PORT=3001
NODE_ENV=development # development | production | test
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (Publicly Exposed in Client Bundle)
VITE_API_BASE_URL=/api # Use https://api.yourdomain.com/api in production if decoupled

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database Configuration (Phase 2 & 3: MongoDB Atlas Cloud Integration)
# SQLite: Legacy / migration source database backup (DO NOT DELETE)
DATABASE_PATH=./server/data/resumio.db

# MongoDB Atlas: Primary application database (Cloud Atlas or Local)
# Replace placeholders with your Atlas cluster details:
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/resumio_dev?retryWrites=true&w=majority
MONGODB_DATABASE=resumio_dev

# AI & LLM Service Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_MODEL_VERSION=resumio-ai-v1
AI_FALLBACK_MODE=deterministic

# File Upload Storage Limits
MAX_RESUME_FILE_SIZE_BYTES=10485760 # 10MB
ALLOWED_RESUME_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
AUTH_RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_WINDOW_MS=300000   # 5 minutes
AI_RATE_LIMIT_MAX_REQUESTS=120
