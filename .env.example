# ===================================================
# Resumio - Typed Environment Variables Configuration
# ===================================================

# Server Runtime
NODE_ENV=development # development | production | test
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Public Base URL
VITE_API_BASE_URL=/api

# Authentication & Security
JWT_SECRET=resumio_dev_secret_key_super_secure_2026_change_in_prod
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database Configuration
DATABASE_PATH=./server/data/resumio.db
MONGODB_URI=
MONGODB_DATABASE=resumio_dev

# AI & LLM Service Configuration
GEMINI_API_KEY=
AI_MODEL_VERSION=gemini-1.5-flash
AI_FALLBACK_MODE=deterministic

# Python ML Microservice (Phase 0 Monorepo Contract)
ML_SERVICE_URL=http://localhost:8000

# File Upload Storage Limits
MAX_RESUME_FILE_SIZE_BYTES=10485760 # 10MB
ALLOWED_RESUME_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
